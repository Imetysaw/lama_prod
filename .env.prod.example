# LaMa configuration for PRODUCTION (Docker/docker-compose.prod.yml).
#
#   cp .env.prod.example .env.prod      # .env.prod is git-ignored
#   # edit .env.prod: set DOMAIN, CERTBOT_EMAIL and replace every CHANGE_ME
#
# Generate random secrets with e.g.:  openssl rand -hex 32

# --- Domain & HTTPS ----------------------------------------------------------
# Public DNS name of the server. Its A/AAAA record must point to this server,
# and ports 80 and 443 must be reachable from the internet for Let's Encrypt.
DOMAIN=lama.example.org
# Let's Encrypt sends certificate expiry warnings to this address
CERTBOT_EMAIL=CHANGE_ME@example.org
# Set to 1 to test against the Let's Encrypt staging environment (untrusted
# certificates, but much higher rate limits). Remove the certbot volumes after testing.
CERTBOT_STAGING=0
# https = nginx terminates TLS with a Let's Encrypt certificate (default)
# http  = plain HTTP only, e.g. when another reverse proxy on the host already does TLS
NGINX_MODE=https
# Host ports nginx is published on
HTTP_PORT=80
HTTPS_PORT=443

# --- Database ----------------------------------------------------------------
DB_HOSTNAME=lama-db
DB_PORT=3306
DB_USER=lamaUser
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
DATABASE_NAME=lama
DIALECT=mysql
DRIVER=mysqldb

# PhpMyAdmin is not started by default. Start it with `--profile tools`; it is then
# only reachable from the server itself (use an SSH tunnel: ssh -L 8081:localhost:8081 server)
PMA_PORT=8081

# --- LaMa --------------------------------------------------------------------
# Super admin created on first start. Change the password after the first login too.
SUPER_USER=admin
SUPER_PASSWORD=CHANGE_ME
SUPER_EMAIL=
# False = new accounts must be approved by a super admin
AUTO_APPROVAL=False

# --- Flask / gunicorn ----------------------------------------------------------
FLASK_APP=src
FLASK_RUN_PORT=5000
APP_ENV=production
# REQUIRED: key used to sign login tokens (openssl rand -hex 32)
SECRET_KEY=CHANGE_ME
TOKEN_EXPIRY_HOURS=24
GUNICORN_WORKERS=4
# Empty = no cross-origin requests allowed (frontend and API share one origin)
CORS_ORIGINS=

# --- Frontend ------------------------------------------------------------------
PROD_API_URL=/api
