# LaMa configuration for DEVELOPMENT (docker-compose.dev.yml, ng serve, flask run).
# For production copy .env.prod.example to .env.prod instead. Never use these
# default passwords on a server.

# Database
DB_HOSTNAME=lama-db
DB_PORT=3306
DB_USER=lamaUser
DB_PASSWORD=password
DB_ROOT_PASSWORD=rootPassword
DATABASE_NAME=lama
DIALECT=mysql
DRIVER=mysqldb

# PhpMyAdmin (only reachable from this machine)
PMA_PORT=81

# LaMa Config
SUPER_USER=admin
SUPER_PASSWORD=password
SUPER_EMAIL=
AUTO_APPROVAL=True

# Flask Server
FLASK_APP=src
FLASK_RUN_PORT=5000
# development = Flask dev server with auto reload; production = gunicorn
APP_ENV=development
# Key used to sign login tokens. Leave empty in development to generate a random one.
SECRET_KEY=
# Hours a login stays valid
TOKEN_EXPIRY_HOURS=24
# Origins allowed to call the API directly (ng serve runs on localhost:4200)
CORS_ORIGINS=http://localhost:4200

# Frontend / nginx
# Port on this machine where the dockerized app is served (http://localhost:8080)
HTTP_PORT=8080
# API URL used by `ng serve` (talks to flask directly)
API_URL=http://localhost:${FLASK_RUN_PORT}
# API URL used by production builds (nginx proxies /api to flask)
PROD_API_URL=/api
